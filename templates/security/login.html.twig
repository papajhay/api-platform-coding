{% extends '@EasyAdmin/page/login_minimal.html.twig' %}
{% trans_default_domain 'messages' %}

{% block body_class 'page-login' %}
{% block page_title %}Admin Login{% endblock %}

{% block wrapper_wrapper %}
    {{ include('@EasyAdmin/flash_messages.html.twig') }}

    <div class="login-wrapper">
        <header class="main-header">
            <div id="header-logo">
                <div class="logo">{{ block('page_title') }}</div>
            </div>
        </header>

        <section class="content">
            {% if error %}
                <div class="w-100 alert alert-danger rounded mb-3">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% block login_form_wrapper %}
                <form method="post">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    {% block login_form_credentials_wrapper %}
                        <div class="form-group">
                            <label class="form-control-label required" for="username">Email</label>
                            <div class="form-widget">
                                <input
                                    type="email"
                                    id="username"
                                    name="_username"
                                    class="form-control"
                                    value="{{ last_username }}"
                                    required
                                    autofocus
                                    autocomplete="username"
                                >
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-control-label required" for="password">Password</label>
                            <div class="form-widget">
                                <input
                                    type="password"
                                    id="password"
                                    name="_password"
                                    class="form-control"
                                    required
                                    autocomplete="current-password"
                                >
                            </div>
                        </div>
                    {% endblock login_form_credentials_wrapper %}

                    <button type="submit" class="btn btn-primary btn-lg btn-block">Sign in</button>
                </form>
            {% endblock login_form_wrapper %}
        </section>
    </div>
{% endblock wrapper_wrapper %}
